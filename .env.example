# Public site origin used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://hopeservicesid.com

# Form delivery (Contact page + Service Coordinators referral form).
# When both RESEND_API_KEY and INQUIRY_TO are set, submissions are emailed via Resend.
# When unset, submissions are logged to the server console instead.
RESEND_API_KEY=
INQUIRY_TO=admin@hopeservicesid.com
INQUIRY_FROM="Hope Services Website <no-reply@hopeservicesid.com>"

# Homepage video (optional): a public MP4 path/URL, or a public iframe embed URL.
NEXT_PUBLIC_VIDEO_SRC=
NEXT_PUBLIC_VIDEO_EMBED=
